{
  "name": "@orbita/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Design system de Órbita Creativa: tokens, átomos, moléculas y organismos, documentados en Storybook.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
